# Husky Tech Repairs — environment variables
# Copy to .env.local for local development. Never commit real values.

# --- Site -------------------------------------------------------------
# Public production origin, used for canonical URLs, sitemap, robots and OG images.
# TODO(Prince): set to the real domain before launch, e.g. https://huskytechrepairs.com.au
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Feature flags ------------------------------------------------------
# Launch profile preset: motherboard-only | repair-core | launch | repair-plus-business | full-minus-refurb | full
# `launch` (the default) = repair + motherboard repairs + enquiry + Privacy/GrapheneOS pages.
HUSKY_LAUNCH_PROFILE=launch
# Individual overrides win over the profile. Use on/off. Examples:
# HUSKY_FEATURE_BUSINESS=on
# HUSKY_FEATURE_KNOWLEDGE=off

# --- Enquiries (required in production) ----------------------------------
# Neon Postgres connection string (Vercel Marketplace → Neon). Run db/migrations/*.sql once.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Resend API key and the address that receives new-enquiry notifications.
# RESEND_API_KEY=re_xxxxxxxx
# ENQUIRY_NOTIFY_TO=you@example.com
# "From" address for notification emails; must be a verified Resend domain/sender.
# ENQUIRY_NOTIFY_FROM=Husky Tech Repairs <enquiries@your-domain>

# Dev/test only: use the clearly-labelled in-memory enquiry store instead of Postgres.
# Refused in production.
# HUSKY_ENQUIRY_STORE=memory

# --- Build preflight ------------------------------------------------------
# strict = fail the build on placeholder business facts / missing production credentials.
# Vercel production deployments are strict automatically.
# HUSKY_PREFLIGHT=strict
