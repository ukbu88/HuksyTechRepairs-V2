{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    ".next/dev/types/**/*.ts",
    ".next-motherboard-only/types/**/*.ts",
    ".next-motherboard-only/dev/types/**/*.ts",
    ".next-full/types/**/*.ts",
    ".next-full/dev/types/**/*.ts",
    ".next-launch/types/**/*.ts",
    ".next-launch/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "playwright-report",
    "test-results"
  ]
}
